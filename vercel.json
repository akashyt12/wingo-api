{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "wingo-api": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app:app",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "wingo-api"
      }
    }
  ]
}
