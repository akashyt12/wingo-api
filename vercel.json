{
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": [
        "models/**",
        "engine_rules.json",
        "wingo_net.py",
        "wingo_engine.py",
        "predictor.py",
        "app.py"
      ]
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
